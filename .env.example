# Copy to .env and fill in local values. NEVER commit .env.

# --- Environment ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=change-me-local-dev-password

# --- Redis (Phase 11: rate limiting / cache) ---
# REDIS_URL=redis://localhost:6379/0
